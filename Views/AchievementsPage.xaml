<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HabitHero.Views.AchievementsPage" Title="Achievements" BackgroundColor="{StaticResource BackgroundLight}">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Text="Achievements" Style="{StaticResource PageTitle}" />
        <Label Text="Milestones that celebrate your consistency." Style="{StaticResource MutedText}" />
        <CollectionView ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Margin="0,4">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="{Binding Icon}" FontSize="30" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Margin="12,0" Spacing="4">
                                <Label Text="{Binding Title}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Description}" Style="{StaticResource MutedText}" />
                                <Label Text="{Binding StatusText}" TextColor="{StaticResource Primary}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
